SUL_ARTIFACT_ROOT=artifacts
SUL_MODEL_BASE_URL=http://localhost:11434
SUL_MODEL_NAME=qwen3:8b
# Optional comma-separated local Ollama fallbacks, tried in this order.
SUL_MODEL_FALLBACK_NAMES=qwen2.5:3b
SUL_MODEL_CONCURRENCY=1
SUL_MODEL_TIMEOUT_SECONDS=45
SUL_BROWSER_ORIGIN=http://127.0.0.1:8001
SUL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional semantic index. PostgreSQL remains the source of truth.
SUL_QDRANT_URL=http://localhost:6333
SUL_QDRANT_COLLECTION=sul_memory
# Optional Langfuse workspace used for LLM traces. The public key is never sent to the UI.
SUL_LANGFUSE_HOST=
SUL_LANGFUSE_PUBLIC_KEY=
SUL_LANGFUSE_SECRET_KEY=
SUL_LANGFUSE_ENVIRONMENT=development
# PostgreSQL is the durable source of truth for runs, sessions, and memory.
SUL_POSTGRES_DSN=
# Optional Groq model provider. Keep the key local; never commit it.
SUL_MODEL_PROVIDER=ollama
SUL_GROQ_API_KEY=
SUL_GROQ_MODEL_NAME=qwen/qwen3-8-27b
# Optional operator login. Set both for a shared/client deployment.
SUL_DASHBOARD_PASSWORD=
SUL_DASHBOARD_SESSION_SECRET=
# Set true only behind HTTPS in a deployment; leave false for localhost.
SUL_DASHBOARD_COOKIE_SECURE=false
SUL_DASHBOARD_SESSION_TTL_SECONDS=28800
